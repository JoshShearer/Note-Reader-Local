<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.loopstring.ttsbridge">

    <!-- Needed to bind a listening socket, even on loopback. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      THE LINE THE eja APP WAS MISSING. On Android 11+ (API 30+) an app that
      targets 30 or later cannot see or bind a TTS engine service unless it
      declares this query. Without it, TextToSpeech.synthesizeToFile fails
      with "not bound to TTS engine" and no amount of permission granting
      helps. Confirmed on a Pixel 9 Pro XL / Android 17 against
      it.eja.ttsserver, whose dumpsys shows no queriesIntents at all.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application android:label="TTS Bridge" android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true"
                  android:label="TTS Bridge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
