# Dependencies
node_modules/

# Build output. These are attached to GitHub releases, not tracked here:
# Obsidian's installer downloads them from the release, and `ort/` is 32MB of
# WASM copied out of node_modules at build time.
main.js
kokoro-worker.js
ort/
*.map

# Test scratch
tests/.build/

# Local model weights and downloads
models/

# Obsidian plugin data from a local sideload
data.json

# Logs
*.log

# Editors and OS
.vscode/
.idea/
*.iml
.DS_Store

# Agent pipeline state (machine-local, never committed)
# One stamped file per /run-tickets run, so parallel runs never share a record
.claude/pipeline-state*.json
.claude/last-critique.md
.claude/scratch/
# Deploy slot lock: one shared vault folder, taken atomically with mkdir
.claude/deploy.lock/
# Legacy: the repo-wide run lock, removed when runs became parallel. Kept so a
# lock left by an older in-flight run does not show up as untracked.
.claude/pipeline.lock/
