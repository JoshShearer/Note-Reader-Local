{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "CONTEXT.md", ".claude/linear.md"],
  "mcp": {
    "linear-nrl": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push *": "ask",
      "git reset --hard*": "ask",
      "git clean *": "ask",
      "git branch -D *": "ask",
      "rm -rf *": "ask",
      "npm publish*": "deny"
    }
  }
}
